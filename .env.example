# Database
POSTGRES_DB=budgetin
POSTGRES_USER=budgetin
POSTGRES_PASSWORD=budgetin_password
DATABASE_URL=postgres://budgetin:budgetin_password@postgres:5432/budgetin
REDIS_URL=redis://redis:6379

# Backend auth and session
NODE_ENV=development
JWT_SECRET=change_me_in_production
ADMIN_PHONE_NUMBER=081390195600
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_NAME=budgetin_refresh_token
COOKIE_SECURE=false
BOT_INTERNAL_TOKEN=change_me_internal_bot_token
OTP_TRUST_PROXY_HOPS=

# App URLs and ports
PORT=4000
CORS_ORIGIN=http://localhost:3000,https://budgetin.seni.my.id
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://backend:4000
WEB_APP_URL=https://budgetin.seni.my.id/

# Telegram and tunnel
TELEGRAM_BOT_TOKEN=
BOT_USER_EMAIL=telegram@budgetin.local
BOT_USER_PASSWORD=telegram_password
CLOUDFLARE_TUNNEL_TOKEN=
